# Video lives on the presenting laptop, never in git.
*/media/

# Raw material presenters send over — kept beside the deck while it's built.
*/sources/

# Snapshots of a deck directory. The directory is the artefact.
*.zip

.DS_Store

# ...but the template keeps its empty media/ so `cp -R` yields the directory.
!_template/media/
!_template/media/.gitkeep

# Post-event web builds. Regenerate with `npm run web:build <deck>`.
/dist/
node_modules/

# Alcyone is licensed from atipo foundry for one website — emcagliari.com — and the
# licence does not cover redistribution. The .woff2 faces live in each deck directory
# on the presenting laptop, never in the repo, where a clone would hand them out.
*/fonts/*.woff2
